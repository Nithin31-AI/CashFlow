# ========================================================
# cashFlow - Environment Variables Example
# PLAN • FORECAST • GROW
# ========================================================

# Backend Configuration
DATABASE_URL=sqlite:///./cashflow.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/cashflow_db

SECRET_KEY=cashflow-stage1-super-secure-jwt-secret-key-change-in-production-min32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dev Settings
ENVIRONMENT=development
DEV_MODE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
