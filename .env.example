# ========================================================
# cashFlow - Environment Variables Example
# PLAN • FORECAST • GROW
# "Turn financial data into confident business decisions."
# ========================================================

# --------------------------------------------------------
# Database Configuration
# --------------------------------------------------------
# For Local Development (SQLite):
DATABASE_URL=sqlite:///./cashflow.db

# For Production / Docker Compose (PostgreSQL 16):
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/cashflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=cashflow_db

# --------------------------------------------------------
# Security & Session Authentication
# --------------------------------------------------------
SECRET_KEY=cashflow-production-super-secure-jwt-secret-key-min-32-chars-replace-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --------------------------------------------------------
# Google OAuth 2.0 / Google Identity Services
# --------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins:
#   - http://localhost:3000
#   - https://your-production-domain.com
# Authorized Redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://your-production-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --------------------------------------------------------
# File Upload Storage
# --------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# --------------------------------------------------------
# Allowed CORS Origins
# --------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --------------------------------------------------------
# Runtime Environment Settings
# --------------------------------------------------------
ENVIRONMENT=development
DEV_MODE=true

# --------------------------------------------------------
# Frontend Configuration
# --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
