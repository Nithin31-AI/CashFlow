# cashFlow Backend Environment Variables Example
# Copy to .env for local development

# Database connection (PostgreSQL):
DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require
# Alternative for offline development:
# DATABASE_URL=sqlite:///./cashflow.db

# Security & JWT
SECRET_KEY=cashflow-stage1-super-secure-jwt-secret-key-change-in-production-min32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Application Mode
ENVIRONMENT=development
DEV_MODE=true
